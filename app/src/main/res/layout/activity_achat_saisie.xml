<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/achat_color"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 1ere ligne : Date et Heure -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="@string/date" android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_date" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:focusable="false" android:clickable="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="Heure"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_heure" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:focusable="false" android:clickable="false" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 2eme ligne : Fournisseur -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fournisseur" android:textSize="13sp"
                android:textColor="@color/text_secondary" android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp" />
            <Spinner android:id="@+id/spin_fournisseur" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/spinner_bg" />

            <Spinner android:id="@+id/spin_categorie_detail" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/spinner_bg" 
                android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:visibility="gone" />

            <!-- 3eme ligne : Code Barre -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_code_barre"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/code_barre"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_camera"
                android:layout_marginTop="6dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_code_barre" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="number"
                    android:imeOptions="actionSearch" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4eme ligne : Recherche (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Zone de recherche" android:layout_marginTop="6dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <AutoCompleteTextView
                    android:id="@+id/et_art" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textCapWords"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 5eme ligne : Qté + Prix -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="@string/quantite" android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_qte" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="1"
                        android:inputType="numberDecimal" android:selectAllOnFocus="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="@string/prix_unitaire"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_prix" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal" android:selectAllOnFocus="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Liste des lignes -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_lignes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp" />

            <!-- Totaux -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/achat_light"
                android:padding="12dp" android:layout_marginTop="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Remise :" android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_remise"
                            android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="0" android:inputType="numberDecimal"
                            android:textAlignment="textEnd" android:gravity="end" android:selectAllOnFocus="true" />
                    </LinearLayout>
    
                    <TextView android:id="@+id/tv_total"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="15sp" android:textColor="@color/text_primary"
                        android:layout_marginTop="6dp" />
                    <TextView android:id="@+id/tv_net"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/achat_color" android:layout_marginTop="2dp" android:visibility="gone" />
    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Décaissé :" android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_dec"
                            android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="0" android:inputType="numberDecimal"
                            android:textAlignment="textEnd" android:gravity="end" android:selectAllOnFocus="true" />
                    </LinearLayout>
    
                    <LinearLayout android:id="@+id/layout_reste" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Reste (Dette) :" android:textSize="13sp"
                            android:textColor="@color/dette_color" android:textStyle="bold" />
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_reste"
                            android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="0" android:inputType="numberDecimal"
                            android:textAlignment="textEnd" android:gravity="end" android:selectAllOnFocus="true" android:textStyle="bold" android:textColor="@color/dette_color" />
                    </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btn_enregistrer"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="@string/enregistrer" android:layout_marginTop="12dp"
                style="@style/Widget.MaterialComponents.Button" />
            <Button android:id="@+id/btn_annuler"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="@string/annuler" android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button android:id="@+id/btn_supprimer_journee"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="Supprimer cet achat" android:layout_marginTop="16dp"
                android:textColor="@android:color/holo_red_dark" android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
